<?xml version="1.0"?>
<sdf version="1.6">
  <!-- This model intentionally keeps the upstream lidar_2d_v2 model and link
       names so PX4's x500_lidar_2d airframe and Gazebo topic path stay stable.
       The parent x500_lidar_2d model mounts this link on top of base_link. -->
  <model name="lidar_2d_v2">
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.02065 0 0 0</pose>
        <mass>0.11</mass>
        <inertia>
          <ixx>4.66e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.66e-5</iyy>
          <iyz>0</iyz>
          <izz>5.67e-5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.02065 0 0 0</pose>
        <geometry>
          <box><size>0.0556 0.0556 0.0413</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.02065 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.0278</radius><length>0.0413</length></cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar_2d_v2" type="gpu_lidar">
        <gz_frame_id>link</gz_frame_id>
        <pose>0 0 0.055 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <!-- C1: 360 deg, 0.72 deg nominal angular spacing (~500 beams). -->
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <!-- Approximate C1's +/-30 mm range accuracy with 15 mm sigma. -->
            <stddev>0.015</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
