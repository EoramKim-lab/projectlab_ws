<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_lidar_2d">
    <!-- Keep the upstream PX4 X500 base: it contains the NavSat sensor used
         by PX4's simulated GPS driver, plus IMU, barometer and magnetometer. -->
    <include merge="true">
      <uri>x500</uri>
    </include>

    <!-- Top-mounted 2D LiDAR. The local lidar_2d_v2 overlay supplies the C1-like
         360-degree / 10 Hz scan while preserving the PX4 model's topic path. -->
    <include merge="true">
      <uri>model://lidar_2d_v2</uri>
      <pose>0.12 0 0.26 0 0 0</pose>
    </include>
    <joint name="LidarJoint" type="fixed">
      <parent>base_link</parent>
      <child>link</child>
      <pose relative_to="base_link">-0.1 0 0.26 0 0 0</pose>
    </joint>

    <!-- Separate visible GPS antenna/module on the upper rear deck. The actual
         GNSS measurement remains the single navsat_sensor in x500_base; this
         avoids creating a second GPS receiver/topic in PX4 SITL. -->
    <link name="gps_module_link">
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>1.0e-5</ixx>
          <iyy>1.0e-5</iyy>
          <izz>1.0e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="gps_module_collision">
        <geometry><box><size>0.0556 0.0556 0.014</size></box></geometry>
      </collision>
      <visual name="gps_module_case">
        <geometry><box><size>0.0556 0.0556 0.014</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="gps_antenna_puck">
        <pose>0 0 0.010 0 0 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.008</length></cylinder></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="gps_module_joint" type="fixed">
      <parent>base_link</parent>
      <child>gps_module_link</child>
      <pose relative_to="base_link">-0.12 0 0.275 0 0 0</pose>
    </joint>
  </model>
</sdf>
